  <!-- Keep a fixed world joint only outside Gazebo.
       In Gazebo, base_link becomes the free root link for physical walking. -->
  <xacro:unless value="$(arg use_gazebo)">
    <link name="world"/>
    <joint name="world_base_link_joint" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>
  </xacro:unless>

